# Rust
/target
**/*.rs.bk

# Node
node_modules/
dist/
web/pkg/

# Runtime state — never committed
data/
# Scratch state from tools/e2e-clip-audio.sh. It stages real media, so an
# uncommitted run is hundreds of megabytes and GitHub refuses the push — which
# is how this line came to exist.
data-e2e*/
e2e-var/
*.db
*.db-wal
*.db-shm

# Vendor SDKs — licensed separately, fetched by the developer (ADR 0003)
sys/decklink-sys/vendor/
sys/ndi-sys/vendor/

# Secrets and local config
.env
.env.local
config.local.json
.claude/settings.local.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Spike scratch output — results go in docs/spikes/, not the artefacts
/spike-out/

# TypeScript incremental build state
*.tsbuildinfo
web/pkg/
/tmp/corpus-*
testdata/golden/wasm/

# Server runtime state: SQLite and the CAS. Content-addressed blobs are
# reproducible from their sources; the database is per-installation.
var/

# Generated by `npm run wasm` from crates/pmg-wasm. Built, never committed —
# a checked-in binary drifts from the Rust it was built from.
src/wasm/
