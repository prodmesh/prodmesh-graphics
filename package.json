{
  "name": "prodmesh-graphics",
  "version": "0.1.0",
  "private": true,
  "license": "LicenseRef-Proprietary",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js --port 8519",
    "dev:web": "vite",
    "build": "npm run wasm && tsc -b && vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --test --test-timeout=20000 server/",
    "test:web": "vitest run",
    "lint": "oxlint server src",
    "selftest": "cargo run -q -p pmg-cli -- --selftest",
    "wire:fixtures": "node tools/write-wire-fixtures.mjs",
    "chaos": "node tools/chaos.mjs",
    "reset-pin": "node tools/reset-pin.mjs",
    "grant-admin": "node tools/grant-admin.mjs",
    "wasm": "cargo build --release -p pmg-wasm --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir src/wasm target/wasm32-unknown-unknown/release/pmg_wasm.wasm"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "bonjour-service": "^1.4.4",
    "cbor-x": "^1.6.5",
    "express": "^5.1.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "oxlint": "^1.22.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
